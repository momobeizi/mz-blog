# Application port bound to the host loopback interface.
# Point the existing Nginx upstream to http://127.0.0.1:${APP_PORT}.
APP_PORT=8080
SITE_BASE_URL=http://localhost:8080

# Set true after enabling HTTPS
COOKIE_SECURE=false

# Existing MySQL. Use host.docker.internal when MySQL runs on the Docker host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=mz_blog_cms
DB_USERNAME=mz_blog
DB_PASSWORD=change-this-database-password
